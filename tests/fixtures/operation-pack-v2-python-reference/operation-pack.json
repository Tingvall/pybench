        {"name": "obs_table", "category": "terminal_artifact", "kind": "obs_table", "storage_profile": "terminal_primitive_v1", "allocated_id_key": "obs_table_id", "required": true, "promotion_group": "g_registry", "table_type": "v2_fixture"},

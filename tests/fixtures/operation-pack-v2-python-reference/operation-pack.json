        "cell_vector_family": "exact_canonical_value",
        "relation_family": "exact_canonical_value",
        "feature_table": "exact_canonical_value",
        "obs_table": "exact_canonical_value",
        "path_2d": "exact_canonical_value",
        "space_path": "exact_canonical_value",
        "cell_set": "exact_membership_and_order"
      }
    },
    {

        {"name": "cell_vector_family", "kind": "cell_vector_family", "required": true, "alignment": "cell_ordered"},
        {"name": "relation_family", "kind": "relation_family", "required": true, "alignment": "cell_ordered"},
        {"name": "feature_table", "kind": "feature_table", "required": true, "alignment": "feature_ordered"},
